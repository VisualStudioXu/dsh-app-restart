{
  "name": "dsh-app-restart",
  "version": "0.1.0",
  "private": true,
  "description": "在界面底部常驻一条「重启 DeepSeek Harness」按钮，带二次确认，重启整个桌面应用。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VisualStudioXu/dsh-app-restart.git"
  },
  "homepage": "https://github.com/VisualStudioXu/dsh-app-restart#readme",
  "bugs": {
    "url": "https://github.com/VisualStudioXu/dsh-app-restart/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "restart"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "license": "MIT"
}
